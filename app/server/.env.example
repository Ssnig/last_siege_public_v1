# Copy to .env and fill in real values.
MONGO_URI=mongodb://localhost:27017/tdgame
# Generate with: openssl rand -base64 48 (at least 32 characters)
JWT_SECRET=replace-me-with-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
# OAuth 2.0 Web application client id from Google Cloud Console.
# Authorized JavaScript origins must include the client's URL.
GOOGLE_CLIENT_ID=
