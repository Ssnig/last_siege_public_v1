{
  "private": true,
  "name": "@root/server",
  "version": "0.1.0",
  "description": "A Colyseus multiplayer server",
  "type": "module",
  "main": "build/index.js",
  "engines": {
    "node": ">= 22.0.0"
  },
  "scripts": {
    "start": "tsx watch src/index.ts",
    "loadtest": "tsx loadtest/example.ts --room my_room --numClients 2",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "rimraf build",
    "test": "mocha -r tsx test/**.test.ts --exit --timeout 30000"
  },
  "author": "",
  "license": "UNLICENSED",
  "overrides": {
    "uWebSockets.js": "github:uNetworking/uWebSockets.js#20.52.0"
  },
  "devDependencies": {
    "@colyseus/loadtest": "^0.18.1",
    "@colyseus/sdk": "^0.18.1",
    "@colyseus/testing": "^0.18.5",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mocha": "^10.0.10",
    "mocha": "^11.7.5",
    "rimraf": "^5.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.4"
  },
  "dependencies": {
    "@colyseus/schema": "^5.0.14",
    "@colyseus/tools": "^0.18.1",
    "@colyseus/uwebsockets-transport": "^0.18.4",
    "@colyseus/ws-transport": "^0.18.4",
    "@root/shared": "*",
    "bcryptjs": "^3.0.3",
    "colyseus": "^0.18.2",
    "dotenv": "^18.0.8",
    "express": "^5.2.1",
    "google-auth-library": "^11.3.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.2"
  }
}
