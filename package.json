{
  "name": "root",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "app/*"
  ],
  "scripts": {
    "dev:shared": "npm run build --workspace=packages/shared -- --watch",
    "dev:server": "npm run start --workspace=app/server",
    "dev:client": "npm run dev --workspace=app/client",
    "build:shared": "npm run build --workspace=packages/shared",
    "build:server": "npm run build:shared && npm run build --workspace=app/server",
    "build:client": "npm run build:shared && npm run build --workspace=app/client",
    "test": "npm run test --workspace=app/server"
  },
  "overrides": {
    "uWebSockets.js": "https://codeload.github.com/uNetworking/uWebSockets.js/tar.gz/refs/tags/v20.52.0"
  },
  "devDependencies": {
    "pngjs": "^7.0.0"
  }
}
